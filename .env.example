# Copy to .env and fill in. Never commit .env.

# Speech-to-text (stage 1)
WHISPER_MODEL_SIZE=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# Leave empty for the default: int8 on CPU, float16 on CUDA
WHISPER_COMPUTE_TYPE=
WHISPER_BEAM_SIZE=5

# LLM stages (Gemini API, key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Refinement (stage 2)
REFINE_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high
REFINE_EFFORT=medium
# Max characters per chunk sent to the model; longer transcripts are split at sentence boundaries
REFINE_CHUNK_CHARS=6000

# Documentation (stage 3): a different model from refinement
MINUTES_MODEL=gemini-3.1-flash-lite
MINUTES_EFFORT=high
