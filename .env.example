# Copy to .env and fill in. Never commit .env.

# Speech-to-text (stage 1)
WHISPER_MODEL_SIZE=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# Leave empty for the default: int8 on CPU, float16 on CUDA
WHISPER_COMPUTE_TYPE=
WHISPER_BEAM_SIZE=5

# LLM stages (Anthropic API)
ANTHROPIC_API_KEY=

# Refinement (stage 2)
REFINE_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max (ignored for Haiku models)
REFINE_EFFORT=medium
# Max characters per chunk sent to the model; longer transcripts are split at sentence boundaries
REFINE_CHUNK_CHARS=6000

# Documentation (stage 3): a different model from refinement
MINUTES_MODEL=claude-opus-5-5
MINUTES_EFFORT=high
